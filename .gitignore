# ==============================================================================
# RustFetch .gitignore
# ==============================================================================

# Rust / Cargo build artifacts
/target/
**/*.rs.bk
Cargo.lock.orig

# IDE and Editor files
.vscode/
.idea/
*.swp
*.swo
*~
.directory

# Operating System files
.DS_Store
Thumbs.db

# Internal Agent & Skill state
.agents/
skills-lock.json

# Local scratch, test files, and experimental assets
scratch/
research/

# Logs, patches, dumps and temporary outputs
*.log
*.tmp
*.color
*.patch
out.txt
