# ==============================================================================
# RustFetch .gitignore
# ==============================================================================

# Rust / Cargo build artifacts
/target/
**/*.rs.bk
Cargo.lock.orig

# IDE and Editor files
.vscode/
.idea/
*.swp
*.swo
*~
.directory

# Operating System files
.DS_Store
Thumbs.db

# Internal Agent & Planning state
PLAN.md
DETAYLI_KOD_ANALIZI.md
PROJECT_MAP.md
MODULES.md
CHANGELOG.md
PONYTAIL-DEBT.md
.agents/
skills-lock.json

# Local scratch, test files, and experimental assets
scratch/
research/

# Logs, patches, dumps and temporary outputs
*.log
*.tmp
*.color
*.patch
out.txt

# Python
__pycache__/
*.pyc

# Archives, packages and checksums
*.tar.gz
*.tar.xz
*.tar.bz2
*.zip
*.sha256

# Cache and core dumps
.cache/
*.dump
core.[0-9]*
